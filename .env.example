# Copy to .env and fill in. Never commit .env. See DESIGN.md Section 13.

# Package modes: mock | real
TREASURY_MODE=mock
RISK_MODE=mock
VENUES_MODE=mock
STRATEGY_MODE=mock
DEMO_MODE=true
PORT=4000
DATABASE_PATH=./data/ttp.sqlite

# Gemini sandbox (human item 1)
GEMINI_SANDBOX_KEY=
GEMINI_SANDBOX_SECRET=

# Deribit testnet main account (human item 2)
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
# Deribit testnet perp subaccount (human item 3)
DERIBIT_PERP_CLIENT_ID=
DERIBIT_PERP_CLIENT_SECRET=

# Arc testnet (human items 4, 5)
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_AGENT_PRIVATE_KEY=
ARC_OWNER_ADDRESS=
ARC_GUARDIAN_ADDRESS=
ARC_SETTLEMENT_ADDRESS=
VAULT_ADDRESS=

# Hosting + MCP (human item 6)
PUBLIC_BASE_URL=
MCP_BEARER_TOKEN=

# LLM (human item 8)
LLM_API_KEY=

# Alerts, extra (human item 11)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
