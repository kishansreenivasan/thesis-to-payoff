# Copy to .env and fill in. Never commit .env. See DESIGN.md Section 13.

# Package modes: mock | real
TREASURY_MODE=mock
RISK_MODE=mock
VENUES_MODE=mock
STRATEGY_MODE=mock
DEMO_MODE=true
PORT=4000
DATABASE_PATH=./data/ttp.sqlite

# Gemini sandbox (human item 1)
GEMINI_SANDBOX_KEY=
GEMINI_SANDBOX_SECRET=
# Only for master API keys: which account to trade (default primary).
GEMINI_ACCOUNT=

# Derive testnet (human items 2-3). L1 option + L2 perp. Test-only wallet; Sepolia, no real funds.
# DERIVE_WALLET: the account owner address shown in testnet.app.derive.xyz.
# DERIVE_SIGNER_PRIVATE_KEY: that wallet's private key, or a registered session key.
DERIVE_WALLET=
DERIVE_SIGNER_PRIVATE_KEY=
DERIVE_MAIN_SUBACCOUNT_ID=
DERIVE_PERP_SUBACCOUNT_ID=

# Arc testnet (human items 4, 5)
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_AGENT_PRIVATE_KEY=
ARC_OWNER_ADDRESS=
ARC_GUARDIAN_ADDRESS=
ARC_SETTLEMENT_ADDRESS=
VAULT_ADDRESS=

# Hosting + MCP (human item 6)
PUBLIC_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
MCP_BEARER_TOKEN=

# Alerts, extra (human item 11)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
